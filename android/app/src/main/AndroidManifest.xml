<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- PHP サーバーが接続を受けるため -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 記録会の間、画面を消してもサーバーを止めないため -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="ArcRec"
        android:supportsRtl="false"
        android:theme="@style/Theme.ArcRec"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".AdminActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".LogActivity"
            android:exported="false"
            android:label="サーバーのログ"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".LicenseActivity"
            android:exported="false"
            android:label="オープンソースライセンス"
            android:parentActivityName=".MainActivity" />

        <service
            android:name=".ServerService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Local web server (PHP) for archery score recording over Wi-Fi tethering" />
        </service>
    </application>
</manifest>
